rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function boundedText(value, maximum) { return value is string && value.size() <= maximum; }
    function validLayouts(value) {
      return value is map && value.keys().hasOnly(['races', 'circuits', 'collection'])
        && value.get('races', 'gallery') in ['gallery', 'list']
        && value.get('circuits', 'gallery') in ['gallery', 'list']
        && value.get('collection', 'gallery') in ['gallery', 'list'];
    }
    function validProfile(data) {
      return data.keys().hasAll(['name', 'favoriteTeam', 'theme', 'layouts', 'migrationComplete', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'favoriteTeam', 'theme', 'layouts', 'migrationComplete', 'createdAt', 'updatedAt'])
        && boundedText(data.name, 80) && boundedText(data.favoriteTeam, 100)
        && data.theme in ['dark', 'light'] && validLayouts(data.layouts)
        && data.migrationComplete is bool && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function validCircuit(circuit) {
      return circuit is map && circuit.keys().hasAll(['circuitId', 'circuitName', 'url', 'Location'])
        && circuit.keys().hasOnly(['circuitId', 'circuitName', 'url', 'Location'])
        && boundedText(circuit.circuitId, 80) && boundedText(circuit.circuitName, 200) && boundedText(circuit.url, 2048)
        && circuit.Location is map && circuit.Location.keys().hasAll(['locality', 'country', 'lat', 'long'])
        && circuit.Location.keys().hasOnly(['locality', 'country', 'lat', 'long'])
        && boundedText(circuit.Location.locality, 200) && boundedText(circuit.Location.country, 100)
        && boundedText(circuit.Location.lat, 40) && boundedText(circuit.Location.long, 40);
    }
    function validRace(race, key) {
      return race is map && race.keys().hasAll(['season', 'round', 'date', 'time', 'raceName', 'Circuit'])
        && race.keys().hasOnly(['season', 'round', 'date', 'time', 'raceName', 'Circuit'])
        && race.season is string && race.season.matches('^[0-9]{4}$')
        && race.round is string && race.round.matches('^[1-9][0-9]{0,2}$')
        && key == race.season + '-' + race.round
        && race.date is string && race.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && boundedText(race.time, 40) && boundedText(race.raceName, 200) && validCircuit(race.Circuit);
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow list, delete: if false;
      allow create: if owner(uid) && validProfile(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'favoriteTeam', 'theme', 'layouts', 'migrationComplete', 'updatedAt']);
      match /collection/{key} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasAll(['favorite', 'watched', 'watchlist', 'race', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['favorite', 'watched', 'watchlist', 'race', 'updatedAt'])
          && request.resource.data.favorite is bool && request.resource.data.watched is bool && request.resource.data.watchlist is bool
          && !(request.resource.data.watched && request.resource.data.watchlist)
          && (request.resource.data.favorite || request.resource.data.watched || request.resource.data.watchlist)
          && request.resource.data.updatedAt == request.time && validRace(request.resource.data.race, key);
      }
      match /signins/{session} {
        allow read: if owner(uid);
        allow create: if owner(uid) && session.matches('^[0-9]{1,16}$')
          && request.resource.data.keys().hasAll(['signedInAt', 'createdAt', 'browser', 'device'])
          && request.resource.data.keys().hasOnly(['signedInAt', 'createdAt', 'browser', 'device'])
          && request.resource.data.signedInAt is timestamp && request.resource.data.signedInAt <= request.time
          && request.resource.data.createdAt == request.time
          && boundedText(request.resource.data.browser, 40) && boundedText(request.resource.data.device, 40);
        allow update: if false;
        allow delete: if owner(uid);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
